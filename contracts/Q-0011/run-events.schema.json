{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quorum.local/contracts/Q-0011/run-events.schema.json",
  "title": "Q-0011 run event",
  "$ref": "#/$defs/envelope",
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "step_started"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/step_started_data"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "text"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/text_data"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "tool"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/tool_data"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "verdict"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/verdict_data"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "usage"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/usage_data"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "retry"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/retry_data"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "step_completed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/step_completed_data"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "step_failed"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/step_failed_data"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "raw"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "data": {
            "$ref": "#/$defs/raw_data"
          }
        }
      }
    }
  ],
  "$defs": {
    "envelope": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1
        },
        "ts": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "enum": [
            "step_started",
            "text",
            "tool",
            "verdict",
            "usage",
            "retry",
            "step_completed",
            "step_failed",
            "raw"
          ]
        },
        "data": {
          "type": "object"
        }
      },
      "required": [
        "schema_version",
        "ts",
        "seq",
        "type",
        "data"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "input_tokens": {
          "$ref": "#/$defs/nullable_number"
        },
        "output_tokens": {
          "$ref": "#/$defs/nullable_number"
        },
        "cached_input_tokens": {
          "$ref": "#/$defs/nullable_number"
        },
        "cache_write_input_tokens": {
          "$ref": "#/$defs/nullable_number"
        },
        "cost_usd": {
          "$ref": "#/$defs/nullable_number"
        }
      },
      "required": [
        "vendor",
        "input_tokens",
        "output_tokens",
        "cached_input_tokens",
        "cache_write_input_tokens",
        "cost_usd"
      ],
      "additionalProperties": false
    },
    "nullable_number": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "error": {
      "type": "object",
      "properties": {
        "category": {
          "enum": [
            "auth",
            "transient",
            "structured_output",
            "adapter",
            "script",
            "integrate",
            "interrupted",
            "unknown"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "category",
        "message"
      ],
      "additionalProperties": false
    },
    "step_started_data": {
      "type": "object",
      "properties": {
        "step_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "adapter",
            "script",
            "integrate",
            "gate"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "adapter": {
          "type": [
            "string",
            "null"
          ]
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "argv": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "step_id",
        "kind",
        "role",
        "adapter",
        "model",
        "argv"
      ],
      "additionalProperties": false
    },
    "text_data": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "tool_data": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "started",
            "completed",
            "failed"
          ]
        },
        "input": {
          "type": [
            "string",
            "null"
          ]
        },
        "output": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "status",
        "input",
        "output"
      ],
      "additionalProperties": false
    },
    "verdict_data": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "value",
        "findings"
      ],
      "additionalProperties": false
    },
    "usage_data": {
      "type": "object",
      "properties": {
        "usage": {
          "$ref": "#/$defs/usage"
        }
      },
      "required": [
        "usage"
      ],
      "additionalProperties": false
    },
    "retry_data": {
      "type": "object",
      "properties": {
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 2
        },
        "delay_ms": {
          "type": "integer",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "vendor",
        "attempt",
        "max_attempts",
        "delay_ms",
        "reason",
        "message"
      ],
      "additionalProperties": false
    },
    "step_completed_data": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "completed",
            "aborted",
            "regressed",
            "exhausted"
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "status",
        "duration_ms"
      ],
      "additionalProperties": false
    },
    "step_failed_data": {
      "type": "object",
      "properties": {
        "status": {
          "enum": [
            "failed",
            "interrupted"
          ]
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "$ref": "#/$defs/error"
        }
      },
      "required": [
        "status",
        "duration_ms",
        "error"
      ],
      "additionalProperties": false
    },
    "raw_data": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    }
  }
}
