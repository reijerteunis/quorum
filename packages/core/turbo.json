{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // As in packages/shared/turbo.json: a hit claims that nothing this task READS has changed.
    // Note the closure — this suite asserts over `turbo.json` and `.github/workflows/ci.yml`, so
    // declaring them makes the Q-0065, Q-0071 and Q-0072 guards inputs of the task that runs them.
    // `src/turbo-inputs.test.ts` is what fails when a read stops being covered. Q-0072.
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../.github/workflows/ci.yml",
        // Q-0079: test-command.test.ts asserts over the sweep script's own text, so this
        // task reads it and a cached pass must not stand over an edited sweep.
        "../../.github/scripts/**",
        "../../turbo.json",
        "../../pnpm-lock.yaml",
        // Q-0050 AC-13d: q0050.source.test.ts scans authority lines against the decisions
        // index and this ticket's body for a transcribed sentence.
        "../../docs/DECISIONS.md",
        "../../docs/03-adapter-contract.md",
        "../../docs/04-architecture.md",
        "../../contracts/Q-0006/review-artifacts.schema.json",
        "../../contracts/Q-0006/ticket-review-state.schema.json",
        "../../contracts/Q-0011/run-manifest.schema.json",
        // Q-0050: src/engine/engine.test.ts IMPORTS this fixture as JSON. The guard in
        // src/turbo-inputs.test.ts excludes module specifiers by design, so an import that
        // leaves the package into a non-package directory is invisible to it and nothing
        // would report the omission. Declared by hand at Q-0050's qa-red gate.
        "../../contracts/Q-0050/run-messages.fixture.json",
        "../../backlog/*/ticket.md",
        // Q-0050: engine.test.ts writes a `harness/harness.yaml` into a TEMP repository, so
        // this task does not read the repository's copy. Declared anyway: clause B collects
        // the literal, and over-declaring can only cost an unnecessary re-run, while the
        // alternatives — a global NOT_READ entry, or assembling the literal — would either
        // stop the guard checking this path for `shared`, which does read it, or trade one
        // clause for another.
        "../../harness/harness.yaml",
        "../../harness/flows/*.yaml",
        "../../spike/src/**",
        // Q-0081: src/git-identity.test.ts scans the spike TEST tree for commit-creating git
        // calls, so this task reads it. The accepted cost is stated rather than discovered:
        // seventeen spike test files now invalidate `@quorum/core#test`. That is the price of
        // the guard being able to see the tree it polices — Q-0051's red CI was three merge
        // calls in a file no core task declared.
        "../../spike/test/**",
        "../../spike/templates/harness/flows/*.yaml",
        // Q-0054: src/test-discovery.test.ts expands the workspace globs and then asks, of every
        // package, whether its Vitest configuration collects each of its test files. So this task
        // reads every package's manifest and configuration, and its verdict depends on which test
        // files exist. `vitest.shared.js` is not here because root turbo.json already hashes it as a
        // globalDependency, which is the same claim by a different route.
        "../../pnpm-workspace.yaml",
        "../../packages/*/package.json",
        "../../packages/*/vitest.config.js",
        "../../packages/*/**/*.test.ts",
        "../../apps/*/package.json",
        "../../apps/*/vitest.config.js",
        "../../apps/*/**/*.test.ts"
      ]
    }
  }
}
