{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // A hit on this task claims that nothing it READS has changed, so every file this package's
    // suite opens outside itself is declared here beside `$TURBO_DEFAULT$`, which keeps the
    // package-relative set rather than replacing it. `packages/core/src/turbo-inputs.test.ts` is
    // what fails when a read stops being covered. Q-0072.
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        // Q-0097 AC-24: docs.test.ts compares 04-architecture.md's description of the emit against
        // the shipped build task rather than against a literal, so a cached pass must not stand over
        // a `turbo.json` whose `outputs` has moved away from what the document says.
        "../../turbo.json",
        // Q-0098 AC-21: docs.test.ts scans every document this ticket edits for an unqualified
        // registry claim, and reads docs/README.md's term list beside the glossary entries it must
        // move with. `harness/product-context.md` is read for the same scan and matters most of the
        // four, being what every product-manager step is fed at run time.
        "../../docs/01-product-definition.md",
        "../../docs/README.md",
        "../../harness/product-context.md",
        "../../docs/02-sdlc-pipeline-spec.md",
        "../../docs/03-adapter-contract.md",
        "../../docs/04-architecture.md",
        "../../docs/06-development-plan.md",
        "../../docs/DECISIONS.md",
        "../../docs/decisions/*.md",
        "../../docs/GLOSSARY.md",
        // Q-0108: docs.test.ts compares CLAUDE.md's term list against docs/README.md's, the two
        // places the vocabulary rule is stated. Declared by hand like `turbo.json` above, because
        // the scanner in packages/core/src/turbo-inputs.test.ts skips any literal with no "/" and so
        // never considers a root-level file at all. Reading this file is ruled in docs.test.ts's own
        // authority comment: Q-0103 E-2 made it the human's to WRITE, which is a different act.
        "../../CLAUDE.md",
        "../../harness/harness.yaml",
        // Q-0107 AC-18: role.test.ts compares the third column of `harness/architecture.md`'s role
        // table against every role's `paths:` frontmatter. `spike/test/smoke.js` was the only thing
        // doing that and Q-0103 deletes it, so the read — and the hash — move here.
        "../../harness/architecture.md",
        "../../harness/flows/*.yaml",
        "../../harness/roles/*.md",
        "../../backlog/*/ticket.md",
        // Q-0107 AC-17: the three `../../spike/**` entries that stood here are gone with the last
        // reader in this package. What replaced them is below — the same assertions, aimed at the
        // tree that survives the cutover, which this package reads as TEXT and never imports.
        "../../packages/cli/templates/harness/harness.yaml",
        "../core/package.json",
        "../core/src/adapters/adapters.ts",
        "../core/src/adapters/claude.ts",
        "../core/src/adapters/codex.ts",
        "../core/src/adapters/mock.ts",
        "../core/src/backlog/backlog.ts",
        "../core/src/backlog/project.ts",
        "../core/src/contracts/contracts.ts",
        "../core/src/contracts/run-manifest.ts",
        "../core/src/engine/prompt.ts"
      ]
    }
  }
}
