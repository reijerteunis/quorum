{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // A hit on this task claims that nothing it READS has changed, so every file this package's
    // suite opens outside itself is declared here beside `$TURBO_DEFAULT$`, which keeps the
    // package-relative set rather than replacing it. `packages/core/src/turbo-inputs.test.ts` is
    // what fails when a read stops being covered. Q-0072.
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../pnpm-lock.yaml",
        // Q-0097 AC-24: docs.test.ts compares 04-architecture.md's description of the emit against
        // the shipped build task rather than against a literal, so a cached pass must not stand over
        // a `turbo.json` whose `outputs` has moved away from what the document says.
        "../../turbo.json",
        // Q-0098 AC-21: docs.test.ts scans every document this ticket edits for an unqualified
        // registry claim, and reads docs/README.md's term list beside the glossary entries it must
        // move with. `harness/product-context.md` is read for the same scan and matters most of the
        // four, being what every product-manager step is fed at run time.
        "../../docs/01-product-definition.md",
        "../../docs/README.md",
        "../../harness/product-context.md",
        "../../docs/02-sdlc-pipeline-spec.md",
        "../../docs/03-adapter-contract.md",
        "../../docs/04-architecture.md",
        // Q-0068 AC-6: docs.test.ts holds USAGE.md's quotation of the BYOS refusal against the
        // literal packages/core/src/adapters/claude.ts throws, so a cached pass must not stand over
        // a document that has drifted from the sentence it quotes. The adapter side of that
        // comparison is already declared below.
        "../../docs/USAGE.md",
        // Q-0017 AC-15: docs.test.ts holds the design brief against the answer set
        // `gateAnswerSchema` declares, the brief having been the third document to promise the gate
        // override the engine refuses and the last to be corrected. A cached pass must not stand
        // over a brief that has drifted back.
        "../../docs/05-design-prompt.md",
        // Q-0017 AC-4: docs.test.ts holds `apps/web/test/source.test.ts`'s network-scan title
        // against `docs/04-architecture.md`'s sentence about the same property, so the two cannot
        // drift apart again. The anchor is here rather than in `apps/web` for the reason this
        // package's own `apps/web` block already gives: that task would otherwise earn its first
        // `turbo.json` for one assertion, and this task already declares the document.
        "../../apps/web/test/source.test.ts",
        // …and the module that made the old claim false, which the same block reads to prove the
        // narrowing has an occasion rather than being a document weakened for nothing.
        "../../apps/web/src/daemon-client.ts",
        "../../docs/06-development-plan.md",
        // Q-0129 AC-12: docs.test.ts parses the superseded-by note in the run-event contract and
        // resolves its citation against the index and the entry folder below, so a cached pass must
        // not stand over a note whose citation has drifted from the entry it names. **The first
        // file under `contracts/` any suite in this workspace reads** — that directory has no
        // package, so nothing had opened one before and no task declared one.
        "../../contracts/Q-0050/run-events.contract.md",
        "../../docs/DECISIONS.md",
        "../../docs/decisions/*.md",
        "../../docs/GLOSSARY.md",
        // Q-0108: docs.test.ts compares CLAUDE.md's term list against docs/README.md's, the two
        // places the vocabulary rule is stated. Declared by hand like `turbo.json` above, because
        // the scanner in packages/core/src/turbo-inputs.test.ts skips any literal with no "/" and so
        // never considers a root-level file at all. Reading this file is ruled in docs.test.ts's own
        // authority comment: Q-0103 E-2 made it the human's to WRITE, which is a different act.
        "../../CLAUDE.md",
        "../../harness/harness.yaml",
        // Q-0124 AC-13: docs.test.ts holds README.md's packed-install block and
        // harness/product-context.md's pillar 7 against the set of packages that really declare a
        // `files` allow-list, rather than against a written-down count — so a sixth distributed
        // package fails until both documents move. That needs the manifests as well as the README,
        // and both workspace roots, because one of the five lives under `apps/`. The
        // `../core/package.json` entry below predates this and is a subset of the first glob; it is
        // left where it is because it is declared for a different reader and a glob covering it is
        // not a second claim about it.
        "../../README.md",
        "../../packages/*/package.json",
        "../../apps/*/package.json",
        // Collected by clause B from the `package.json` literal that walk joins onto each package
        // directory: the scan resolves a bare root-level literal against the repository root, so the
        // root manifest is declared even though the walk never opens it. `packages/core` declares
        // the same file for the same reason (Q-0108), and the alternative — spelling the name some
        // other way to evade the scan — is the obfuscation that guard exists to refuse.
        "../../package.json",
        // Q-0107 AC-18: role.test.ts compares the third column of `harness/architecture.md`'s role
        // table against every role's `paths:` frontmatter. `spike/test/smoke.js` was the only thing
        // doing that and Q-0103 deletes it, so the read — and the hash — move here.
        "../../harness/architecture.md",
        // Q-0115 AC-12: docs.test.ts holds the canonical rules file to a register of its own rules,
        // so that the one sentence decision 088 routes there stays one and nothing else moved with
        // it. A cached pass must not stand over an edited rule.
        "../../harness/rules.md",
        "../../harness/flows/*.yaml",
        "../../harness/roles/*.md",
        "../../backlog/*/ticket.md",
        // Q-0107 AC-17: the three `../../spike/**` entries that stood here are gone with the last
        // reader in this package. What replaced them is below — the same assertions, aimed at the
        // tree that survives the cutover, which this package reads as TEXT and never imports.
        "../../packages/cli/templates/harness/harness.yaml",
        // Q-0083: flow.test.ts compares the shipped chore flow and the role that answers its new
        // verdict against the adopter's copies, so a change to either half must move this hash.
        "../../packages/cli/templates/harness/flows/chore.yaml",
        "../../packages/cli/templates/harness/roles/developer-generalist.md",
        "../core/package.json",
        "../core/src/adapters/adapters.ts",
        "../core/src/adapters/claude.ts",
        "../core/src/adapters/codex.ts",
        "../core/src/adapters/mock.ts",
        "../core/src/backlog/backlog.ts",
        "../core/src/backlog/project.ts",
        "../core/src/contracts/contracts.ts",
        "../core/src/contracts/run-manifest.ts",
        "../core/src/engine/prompt.ts"
      ]
    }
  }
}
