{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    // As in packages/shared and packages/core: a hit on this task claims that nothing it READS has
    // changed, so every file this package's suite opens outside itself is declared here beside
    // `$TURBO_DEFAULT$`, which keeps the package-relative set rather than replacing it. Q-0072.
    //
    // Only two are named, because the other three the suite reads are already hashed by a
    // mechanism this package declares:
    //   - packages/core/package.json and packages/shared/package.json (src/package.test.ts AC-9)
    //     come in through the `^test` edge that the two workspace dependencies create, which is
    //     what covers `core`'s reads of `shared` and is why turbo-inputs.test.ts's MANIFEST omits
    //     those deliberately;
    //   - tsconfig.base.json is a root `globalDependencies` entry, hashed for every task.
    // Neither `pnpm-lock.yaml` nor the root `package.json` is covered by anything: the first reaches
    // this task only through @quorum/core#test's own declaration, which is not this package's to
    // rely on, and the second is hashed by no task at all. Q-0090 AC-10(a).
    //
    // Q-0097 adds three more, for `src/build.test.ts`. Root `turbo.json` is what AC-7 asserts the
    // `build` task's shape against, `.gitignore` is what AC-12 asks git to attribute the emit to — a
    // cached pass must not stand over an edited rule that has stopped ignoring `dist/` — and
    // `pnpm-workspace.yaml` is one of the four files AC-8's isolated copy needs before turbo can
    // plan a build in it. The other files that guard reads are already hashed: `eslint.config.js`,
    // `vitest.shared.js`, `tsconfig.base.json` and `.nvmrc` are root `globalDependencies`, and
    // everything under `packages/core` and `packages/shared` that the copy carries — their sources
    // as well as `git-identity.test.ts` — arrives through the `^test` edge the workspace
    // dependencies create.
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../pnpm-lock.yaml",
        "../../package.json",
        "../../turbo.json",
        "../../.gitignore",
        "../../pnpm-workspace.yaml",
        "../../.github/workflows/ci.yml",
        "../../.github/scripts/git-identity-sweep.sh",
        "../../harness/harness.yaml"
      ]
    }
  }
}
